# このファイルをコピーして .env を作成し，値を設定してください．
#   cp .env.example .env
# .env は .gitignore に含まれています．絶対にコミットしないでください．

# トークン生成用の秘密鍵（必須）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# トークンはこの鍵とセッションごとの塩(DB)の両方から導出されるため、
# この鍵の漏洩だけで即座に破られることはありませんが、機密として扱ってください
TOKEN_SECRET=

# 学内とみなすIPレンジ（必須・カンマ区切りのCIDR）
# デプロイ後，学内Wi-Fiに接続した状態でIP確認サービスを見て設定します
# 実際の値はコミットしないでください
CAMPUS_IP_RANGES=

# 自分の前段にいる「信頼できるプロキシ」の数
#   0 … ローカル開発（X-Forwarded-For を一切見ない）
#   1 … Render / Railway など、ロードバランサ1台の背後にデプロイした場合
# 誤って大きくすると、クライアントが偽装したIPを信じてしまいます
TRUSTED_PROXY_COUNT=0

# DBの接続先（省略時は ./attendance.db）
DATABASE_URL=

# ログインセッションの有効期間（時間）
SESSION_LIFETIME_HOURS=12

# QRとトークンの更新間隔（秒）
QR_ROTATE_SECONDS=5
TOKEN_ACCEPT_PREVIOUS_WINDOWS=1

# 出席／遅刻の境界（分）
PRESENT_BEFORE_MINUTES=5
PRESENT_AFTER_MINUTES=5
LATE_UNTIL_MINUTES=20

# ログインのレート制限
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# 出席登録のレート制限（本人ごとに数える．IPでは数えない）
# ログインよりかなり緩くしてあります．ここで誤って弾くと，授業に出ている学生が
# 欠席として残ってしまうためです．どの値も1以上にしてください（0は全面禁止になります）．
ATTENDANCE_MAX_FAILURES=10
ATTENDANCE_WINDOW_MINUTES=5
ATTENDANCE_LOCKOUT_MINUTES=2

# バースト検知
BURST_THRESHOLD_COUNT=3
BURST_WINDOW_SECONDS=60

# セキュリティヘッダー
# CSP を Report-Only にする（違反を報告するが止めない）．
# 既定は false（強制）．実地テストでQRの読み取りが動かなくなったときだけ，
# 一時的に true にして原因を切り分ける．直したら必ず false に戻すこと．
CSP_REPORT_ONLY=false

# SQLiteをWALモードで開く（同時アクセスが詰まったときの手当て）
# 既定の false では「書き手1人・書き込み中は読み取りも待つ」ため、授業開始直後に
# 全員が同時に登録すると順番待ちになり、5秒待っても空かないと
# database is locked で500になります。true にすると書き手と読み手が同時に
# 動けるようになり、この待ちが大幅に減ります。
#
# 既定を false にしているのは、実地テストで実際に詰まるかを先に測るためです。
# 詰まったら true にしてアプリを再起動してください（コードの変更は不要）。
#
# 注意：journal_mode はDBファイル側に残ります。一度 true で起動すると、
# false に戻してもファイルはWALのままです。元に戻すには
# PRAGMA journal_mode = DELETE を手で実行してください。
SQLITE_WAL=false
