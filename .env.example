# このファイルをコピーして .env を作成し，値を設定してください．
#   cp .env.example .env
# .env は .gitignore に含まれています．絶対にコミットしないでください．

# トークン生成用の秘密鍵（必須）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# これが漏れると教室にいなくても有効なQRを作れてしまいます
TOKEN_SECRET=

# 学内とみなすIPレンジ（必須・カンマ区切りのCIDR）
# デプロイ後，学内Wi-Fiに接続した状態でIP確認サービスを見て設定します
# 実際の値はコミットしないでください
CAMPUS_IP_RANGES=

# QRとトークンの更新間隔（秒）
QR_ROTATE_SECONDS=5
TOKEN_ACCEPT_PREVIOUS_WINDOWS=1

# 出席／遅刻の境界（分）
PRESENT_BEFORE_MINUTES=5
PRESENT_AFTER_MINUTES=5
LATE_UNTIL_MINUTES=20

# ログインのレート制限
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# バースト検知
BURST_THRESHOLD_COUNT=3
BURST_WINDOW_SECONDS=60
