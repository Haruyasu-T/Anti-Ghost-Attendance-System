# Python
__pycache__/
*.pyc
.pytest_cache/

# 仮想環境
venv/
.venv/
env/

# 秘密の設定値
# .env だけだと .env.local や .env.production が漏れるため .env.* も除外する。
# ただし .env.example は共有したいテンプレートなので ! で除外を打ち消す。
# 打ち消しは除外行より後に書かないと効かない。
.env
.env.*
!.env.example

# Node（開発ツール＝Prettier 用。配布物には入らない）
# package.json / package-lock.json は版を固定するためコミットする。
node_modules/

# データベース
# 学籍番号やパスワードハッシュが入る。拡張子は3種類とも塞ぐ。
*.db
*.sqlite
*.sqlite3

# WALモード（SQLITE_WAL=true）で作られる付属ファイル。
# 名前が attendance.db-wal のようになるので、上の *.db では弾けない。
# -wal には**まだ本体に書き戻していない中身**がそのまま入っている。
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# エディタ
.vscode/
.idea/
